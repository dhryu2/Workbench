# ============================================================
#  Workbench — 운영 환경변수 템플릿 (커밋용)
#  실제 배포 시 .env.production 으로 복사한 뒤 값을 채우세요:
#    cp .env.example .env.production
#  배포:
#    ./scripts/deploy.sh          # 빌드 → GHCR push → 서버 pull+up
# ============================================================

# ---------- 프로젝트 / 이미지 (GHCR) ----------
PROJECT_NAME=workbench
IMAGE_TAG=latest
FRONTEND_IMAGE=ghcr.io/<GH_USER>/workbench-frontend
BACKEND_IMAGE=ghcr.io/<GH_USER>/workbench-backend

# ---------- 포트 ----------
# 프론트 외부 노출 포트 (Cloudflare Tunnel이 연결하는 포트)
FRONTEND_HOST_PORT=23000
BACKEND_CONTAINER_PORT=23001

# ---------- 앱 런타임 ----------
SPRING_PROFILES_ACTIVE=prod
VITE_API_BASE_URL=/api
CORS_ALLOWED_ORIGINS=https://<YOUR_PROD_DOMAIN>

# ---------- 운영 서버 접속정보 ----------
DEPLOY_HOST=<SERVER_HOST_OR_TAILSCALE_IP>
DEPLOY_SSH_USER=<SSH_USER>
DEPLOY_SSH_PORT=22
DEPLOY_SSH_KEY=~/.ssh/id_ed25519
DEPLOY_REMOTE_PATH=/home/<SSH_USER>/deploy/workbench

# ---------- 컨테이너 레지스트리 (GHCR) ----------
REGISTRY=ghcr.io
REGISTRY_USER=<GH_USER>
REGISTRY_PASSWORD=
